{
  "schema_version": 1,
  "id": "wan21-t2v",
  "name": "Wan 2.1 T2V",
  "size_multiple": 16,
  "description": "Text-to-video with Wan 2.1 or a compatible single Wan 2.2 T2V expert. Defaults target Wan 2.1 14B; adjust settings for the selected weights and acceleration LoRAs.",
  "model_url": "https://huggingface.co/Wan-AI/Wan2.1-T2V-14B",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "t5xxl",
      "label": "UMT5-XXL",
      "required": true
    },
    {
      "id": "vae",
      "label": "Wan 2.1 VAE",
      "required": false
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "video_constraints": {
    "frame_step": 4,
    "frame_offset": 1,
    "frame_rounding": "floor",
    "min_frames": 1
  },
  "defaults": {
    "sampling_method": "euler",
    "video_frames": 33,
    "fps": 16,
    "flow_shift": 5,
    "cfg_scale": 5,
    "steps": 20,
    "width": 1280,
    "height": 720
  },
  "features": [
    "flow_shift"
  ],
  "disabled_features": [
    "img2img",
    "mask_image"
  ]
}

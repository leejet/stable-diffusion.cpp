{
  "schema_version": 1,
  "id": "moss-image-base",
  "name": "MOSS Image Base",
  "size_multiple": 16,
  "description": "Select the MOSS-Image-Base transformer with its matching text encoder and FLUX.2 VAE or TAE.",
  "model_url": "https://huggingface.co/OpenMOSS-Team/MOSS-Image-Base",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 3.5 9B Text Encoder"
    },
    {
      "id": "tokenizer",
      "required": true,
      "label": "Qwen 3.5 tokenizer.json"
    },
    {
      "id": "vae",
      "required": false
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "defaults": {
    "cfg_scale": 3,
    "steps": 20,
    "width": 1024,
    "height": 1024,
    "flow_shift": 5,
    "sampling_method": "euler"
  },
  "features": [
    "flow_shift",
    "slg"
  ]
}

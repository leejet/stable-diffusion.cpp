{
  "schema_version": 1,
  "id": "boogu-image-edit",
  "name": "Boogu Image Edit",
  "description": "Supply reference images. The separate vision projector is needed only when it is not bundled in the text encoder.",
  "model_url": "https://huggingface.co/Boogu/Boogu-Image-0.1-Edit",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 3 VL 8B Text Encoder"
    },
    {
      "id": "llm_vision",
      "required": false,
      "label": "Vision projector (required for separate GGUF text encoders)"
    },
    {
      "id": "vae",
      "required": false
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "defaults": {
    "cfg_scale": 5,
    "steps": 20,
    "width": 1024,
    "height": 1024,
    "img_cfg_scale": 1,
    "sampling_method": "euler"
  },
  "features": [
    "flow_shift",
    "img_cfg",
    "ref_images"
  ]
}

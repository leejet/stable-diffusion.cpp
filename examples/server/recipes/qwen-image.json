{
  "schema_version": 1,
  "id": "qwen-image",
  "name": "Qwen Image",
  "description": "Supports text-to-image and image-to-image; pruned transformer variants use the same components.",
  "model_url": "https://huggingface.co/Qwen/Qwen-Image",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 2.5 VL 7B Text Encoder"
    },
    {
      "id": "vae",
      "required": false,
      "label": "Qwen Image VAE"
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "defaults": {
    "sampling_method": "euler",
    "flow_shift": 3.0,
    "cfg_scale": 4,
    "steps": 20,
    "width": 1328,
    "height": 1328
  },
  "features": [
    "flow_shift"
  ]
}

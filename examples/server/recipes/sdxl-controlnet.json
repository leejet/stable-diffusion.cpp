{
  "schema_version": 1,
  "id": "sdxl-controlnet",
  "name": "SDXL ControlNet",
  "description": "Select a compatible SDXL ControlNet and supply a preprocessed control image. Input image and mask are optional for image-to-image or inpainting.",
  "model_url": "https://huggingface.co/diffusers/controlnet-canny-sdxl-1.0",
  "slots": [
    {
      "id": "model",
      "required": true
    },
    {
      "id": "control_net",
      "required": true
    },
    {
      "id": "vae",
      "required": false
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "defaults": {
    "scheduler": "discrete",
    "sampling_method": "euler_a",
    "cfg_scale": 5,
    "steps": 20,
    "width": 1024,
    "height": 1024
  },
  "features": [
    "cache_unet",
    "clip_skip",
    "shifted_timestep"
  ],
  "disabled_features": [
    "cache_dit"
  ]
}

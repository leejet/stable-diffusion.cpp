      "label": "Qwen 2.5 VL 7B Text Encoder"
    },
    {
      "id": "t5xxl",
      "required": true,
      "label": "ByT5 Small GlyphXL"
    },
    {
      "id": "vae",
      "required": false,
      "label": "HunyuanVideo 1.5 VAE"
    },
    {
      "id": "tae",

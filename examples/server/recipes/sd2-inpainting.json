{
  "schema_version": 1,
  "id": "sd2-inpainting",
  "name": "SD 2 Inpainting",
  "description": "Select an inpainting checkpoint, then supply Init Image and Mask Image.",
  "slots": [
    {
      "id": "model",
      "required": true
    },
    {
      "id": "vae",
      "required": false
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "defaults": {
    "scheduler": "discrete",
    "sampling_method": "euler_a",
    "cfg_scale": 7.5,
    "steps": 20,
    "width": 512,
    "height": 512
  },
  "features": [
    "cache_unet",
    "clip_skip",
    "img_cfg"
  ],
  "disabled_features": [
    "cache_dit"
  ]
}

{
  "schema_version": 1,
  "id": "flux1-pulid",
  "name": "FLUX.1 dev PuLID",
  "description": "Supply a precomputed PuLID identity embedding with the generation request.",
  "model_url": "https://huggingface.co/guozinan/PuLID",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "clip_l",
      "required": true
    },
    {
      "id": "t5xxl",
      "required": true
    },
    {
      "id": "pulid_weights",
      "required": true
    },
    {
      "id": "vae",
      "required": false
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "defaults": {
    "sampling_method": "euler",
    "cfg_scale": 1,
    "steps": 20,
    "width": 1024,
    "height": 1024,
    "distilled_guidance": 3.5
  },
  "features": [
    "clip_skip",
    "distilled_guidance",
    "flow_shift",
    "slg"
  ],
  "disabled_features": [
    "slg"
  ]
}

    {
      "id": "t5xxl",
      "required": true
    }
  ],
  "defaults": {
    "sampling_method": "euler",
    "cfg_scale": 3.5,
    "steps": 20,
    "width": 1024,
    "height": 1024
  },
  "features": [
    "flow_shift",
    "slg"
  ],
  "disabled_features": [
    "preview",
    "vae_tiling"
  ]
}

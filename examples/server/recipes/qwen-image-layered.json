{
  "schema_version": 1,
  "id": "qwen-image-layered",
  "name": "Qwen Image Layered",
  "description": "Supply a reference image and use the dedicated layered VAE.",
  "model_url": "https://huggingface.co/Qwen/Qwen-Image-Layered",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 2.5 VL 7B Text Encoder"
    },
    {
      "id": "vae",
      "required": true,
      "label": "Qwen Image Layered VAE"
    }
  ],
  "defaults": {
    "sampling_method": "euler",
    "flow_shift": 3.0,
    "cfg_scale": 4,
    "steps": 20,
    "width": 640,
    "height": 640
  },
  "features": [
    "flow_shift",
    "img_cfg",
    "ref_images"
  ]
}

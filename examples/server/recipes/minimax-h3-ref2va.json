{
  "schema_version": 1,
  "id": "minimax-h3-ref2va",
  "name": "MiniMax H3 Ref2VA",
  "description": "Supply image, video or audio references with compatible Ref2VA weights. Audio VAE is optional for silent video.",
  "model_url": "https://huggingface.co/MiniMaxAI/MiniMax-H3",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "MiniMax-H3 Qwen 3 VL 32B Text Encoder"
    },
    {
      "id": "vae",
      "required": false,
      "label": "MiniMax H3 Video VAE"
    },
    {
      "id": "tae",
      "required": false
    },
    {
      "id": "audio_vae",
      "required": false,
      "label": "MiniMax H3 Audio VAE"
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "defaults": {
    "video_frames": 56,
    "fps": 24,
    "cfg_scale": 1,
    "width": 1344,
    "height": 768,
    "sampling_method": "euler"
  },
  "features": [
    "flow_shift",
    "ref_images",
    "ref_videos",
    "ref_audios",
    "ref_video_audios",
    "init_image",
    "end_image"
  ],
  "disabled_features": [
    "img2img",
    "mask_image"
  ]
}

{
  "schema_version": 1,
  "id": "iris-3b",
  "name": "Iris 3B",
  "size_multiple": 16,
  "description": "Pixel-space model; no VAE is required.",
  "model_url": "https://huggingface.co/speridlabs/iris-3b",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 3 VL 4B Text Encoder"
    }
  ],
  "defaults": {
    "cfg_scale": 3,
    "steps": 20,
    "width": 1024,
    "height": 1024,
    "sampling_method": "euler"
  },
  "features": [
    "flow_shift"
  ],
  "disabled_features": [
    "preview",
    "vae_tiling"
  ]
}

{
  "schema_version": 1,
  "id": "flux3-klein-base",
  "name": "FLUX.3 Image Klein Base",
  "size_multiple": 16,
  "model_url": "https://huggingface.co/black-forest-labs/flux-3-image-klein-base",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 3 VL 4B Text Encoder"
    },
    {
      "id": "vae",
      "required": false
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "defaults": {
    "sampling_method": "euler",
    "cfg_scale": 4,
    "steps": 20,
    "width": 1024,
    "height": 1024
  },
  "features": [
    "flow_shift",
    "ref_images"
  ]
}

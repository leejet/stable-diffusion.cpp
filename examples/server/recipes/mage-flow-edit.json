{
  "schema_version": 1,
  "id": "mage-flow-edit",
  "name": "Mage Flow Edit",
  "size_multiple": 16,
  "description": "Supply reference images. Select a separate vision projector when it is not bundled in the text encoder.",
  "model_url": "https://huggingface.co/microsoft/Mage-Flow-Edit",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 3 VL 4B Text Encoder"
    },
    {
      "id": "vae",
      "required": true
    },
    {
      "id": "llm_vision",
      "required": false,
      "label": "Vision projector (required for separate GGUF text encoders)"
    }
  ],
  "defaults": {
    "sampling_method": "euler",
    "cfg_scale": 5,
    "steps": 20,
    "width": 1024,
    "height": 1024
  },
  "features": [
    "flow_shift",
    "img_cfg",
    "ref_images"
  ]
}

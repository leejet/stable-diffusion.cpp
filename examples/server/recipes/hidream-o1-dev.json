{
  "schema_version": 1,
  "id": "hidream-o1-dev",
  "name": "HiDream O1 Image dev",
  "description": "Bundled checkpoint; also supports reference-image editing.",
  "model_url": "https://huggingface.co/HiDream-ai/HiDream-O1-Image-Dev",
  "slots": [
    {
      "id": "model",
      "required": true
    }
  ],
  "defaults": {
    "cfg_scale": 1,
    "steps": 20,
    "width": 2048,
    "height": 2048,
    "sampling_method": "euler"
  },
  "features": [
    "flow_shift",
    "ref_images"
  ]
}

{
  "schema_version": 1,
  "id": "minimax-h3-fl2va",
  "name": "MiniMax H3 FL2VA",
  "size_multiple": 32,
  "description": "Generate video and audio, optionally with start/end images. Supports full and pruned FL2VA weights. Audio VAE is optional for silent video.",
  "model_url": "https://huggingface.co/MiniMaxAI/MiniMax-H3",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "MiniMax-H3 Qwen 3 VL 32B Text Encoder"
    },
    {
      "id": "vae",
      "required": false,
      "label": "MiniMax H3 Video VAE"
    },
    {
      "id": "tae",
      "required": false
    },
    {
      "id": "audio_vae",
      "required": false,
      "label": "MiniMax H3 Audio VAE"
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "video_constraints": {
    "frame_step": 17,
    "frame_offset": 5,
    "frame_rounding": "ceil",
    "min_frames": 5,
    "fixed_fps": 24
  },
  "defaults": {
    "video_frames": 56,
    "fps": 24,
    "cfg_scale": 1,
    "width": 1344,
    "height": 768,
    "sampling_method": "euler"
  },
  "features": [
    "end_image",
    "flow_shift",
    "init_image"
  ],
  "disabled_features": [
    "img2img",
    "mask_image"
  ]
}

{
  "schema_version": 1,
  "id": "qwen-image-21",
  "name": "Qwen Image 2.1",
  "description": "Supports generation and editing. Select the full Qwen Image 2.1 VAE or TAEQI2.1. Supply a separate vision projector when needed. Select acceleration LoRAs and adjust their settings separately.",
  "model_url": "https://huggingface.co/Qwen/Qwen-Image-2.1",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 3 VL 8B Text Encoder"
    },
    {
      "id": "llm_vision",
      "required": false,
      "label": "Vision projector (required for separate GGUF text encoders)"
    },
    {
      "id": "vae",
      "required": false,
      "label": "Qwen Image 2.1 VAE"
    },
    {
      "id": "tae",
      "required": false,
      "label": "TAEQI2.1"
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "defaults": {
    "sampling_method": "euler",
    "cfg_scale": 1,
    "steps": 20,
    "width": 2048,
    "height": 2048
  },
  "features": [
    "flow_shift",
    "ref_images"
  ]
}

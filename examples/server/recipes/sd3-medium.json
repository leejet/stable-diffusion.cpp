{
  "schema_version": 1,
  "id": "sd3-medium",
  "name": "SD 3 Medium",
  "description": "Checkpoint with CLIP-L, CLIP-G and T5 included.",
  "model_url": "https://huggingface.co/stabilityai/stable-diffusion-3-medium-diffusers",
  "slots": [
    {
      "id": "model",
      "required": true
    },
    {
      "id": "vae",
      "required": false
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "defaults": {
    "sampling_method": "euler",
    "cfg_scale": 7,
    "steps": 20,
    "width": 1024,
    "height": 1024
  },
  "features": [
    "clip_skip",
    "flow_shift",
    "slg"
  ]
}

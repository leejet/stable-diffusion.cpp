{
  "schema_version": 1,
  "id": "z-image",
  "name": "Z-Image",
  "model_url": "https://huggingface.co/Tongyi-MAI/Z-Image",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 3 Text Encoder"

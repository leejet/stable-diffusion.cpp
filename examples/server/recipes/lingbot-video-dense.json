{
  "schema_version": 1,
  "id": "lingbot-video-dense",
  "name": "LingBot Video Dense 1.3B",
  "description": "Use Video Generation.",
  "model_url": "https://huggingface.co/robbyant/lingbot-video-dense-1.3b",
  "slots": [
    {
      "id": "diffusion_model",
      "required": true
    },
    {
      "id": "llm",
      "required": true,
      "label": "Qwen 3 VL 4B Text Encoder"
    },
    {
      "id": "vae",
      "required": false,
      "label": "Wan 2.1 VAE"
    },
    {
      "id": "tae",
      "required": false
    }
  ],
  "required_any": [
    [
      "vae",
      "tae"
    ]
  ],
  "defaults": {
    "video_frames": 33,
    "cfg_scale": 3,
    "steps": 20,
    "width": 832,
    "height": 480,
    "sampling_method": "euler"
  },
  "features": [
    "flow_shift",
    "init_image"
  ],
  "disabled_features": [
    "img2img",
    "mask_image"
  ]
}

# version: 0.0.0
# docs/models/mage_flow.md — Text-to-image

var {
    model_path = "../models/diffusion_models/Mage-Flow-Turbo.safetensors"
    text_path = "../models/text_encoders/Qwen3-VL-4B-Instruct-Q4_K_M.gguf"
    vae_path = "../models/vae/mage_vae.safetensors"

    output_path = "output.png"

    prompt = "a lovely cat holding a sign says 'mage.cpp'"

    seed = 42
    rng_type = "cuda"
    width = 512
    height = 512

    steps = 4
    method = "euler"
    scheduler = "discrete"
}

fn main() {
    model = load_dit(model_path, family = "mage_flow", params_backend = "cpu")
    text = load_text_encoder(text_path, family = "mage_flow", params_backend = "cpu")
    vae = load_vae(vae_path, family = "mage_flow", params_backend = "cpu")

    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    condition = encode_prompt(text, prompt, width = width, height = height)
    predict = predictor(model, condition)
    sigmas = make_sigmas(predict, latent = base, steps = steps, scheduler = scheduler)
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(predict, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = predict, method = method, rng = rng)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

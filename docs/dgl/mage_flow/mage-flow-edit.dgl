# version: 0.0.0
# docs/models/mage_flow.md — Image editing

var {
    model_path = "../models/diffusion_models/Mage-Flow-Edit.safetensors"
    text_path = "../models/text_encoders/Qwen3-VL-4B-Instruct-Q4_K_M.gguf"
    vision_path = "../models/text_encoders/Qwen3-VL-4B-Instruct-mmproj-BF16.gguf"
    vae_path = "../models/vae/mage_vae.safetensors"

    reference_0_path = "../inputs/flux/flux1-dev-q8_0.png"
    output_path = "output.png"

    prompt = "change 'flux.cpp' to 'mage.cpp'"
    negative_prompt = ""

    seed = 42
    rng_type = "cuda"

    steps = 20
    cfg_scale = 4.0
    method = "euler"
    scheduler = "discrete"
}

fn main() {
    reference_0 = image::load(reference_0_path)
    width = tensor::shape(reference_0)[1]
    height = tensor::shape(reference_0)[2]

    model = load_dit(model_path, family = "mage_flow", params_backend = "cpu")
    text = load_text_encoder(text_path, family = "mage_flow", params_backend = "cpu", vision_path = vision_path)
    vae = load_vae(vae_path, family = "mage_flow", params_backend = "cpu")

    encode_rng = make_rng(rng_type, seed = seed)
    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    reference_0_original = image::to_f32(reference_0, channels = 3)
    reference_0_pixels = tensor::interpolate(reference_0_original, size = [width, height], mode = "bilinear")
    reference_latent_0 = vae_to_dit_latents(vae, vae_encode(vae, reference_0_pixels, rng = encode_rng))

    positive = encode_prompt(text, prompt, width = width, height = height, media = [reference_0_original])
    negative = encode_prompt(text, negative_prompt, width = width, height = height, media = [reference_0_original])
    pos = predictor(model, positive, ref_latents = [reference_latent_0], ref_index_mode = "increase")
    neg = predictor(model, negative, ref_latents = [reference_latent_0], ref_index_mode = "increase")
    guided = cfg(pos, neg, scale = cfg_scale)
    sigmas = make_sigmas(guided, latent = base, steps = steps, scheduler = scheduler)
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = guided, method = method, rng = rng)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

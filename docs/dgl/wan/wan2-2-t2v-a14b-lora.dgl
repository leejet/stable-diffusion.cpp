# version: 0.0.0
# docs/models/wan.md — Wan2.2 T2V 14B with Lora

var {
    model_path = "../models/diffusion_models/Wan2.2-T2V-A14B-LowNoise-Q8_0.gguf"
    high_model_path = "../models/diffusion_models/Wan2.2-T2V-A14B-HighNoise-Q8_0.gguf"
    text_path = "../models/text_encoders/umt5-xxl-encoder-Q8_0.gguf"
    vae_path = "../models/vae/wan_2.1_vae.safetensors"
    lora_0_path = "../models/loras/wan2.2_t2v_lightx2v_4steps_lora_v1.1_low_noise"
    lora_1_path = "../models/loras/wan2.2_t2v_lightx2v_4steps_lora_v1.1_high_noise"

    output_path = "output.avi"

    prompt = "a lovely cat"
    negative_prompt = "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走"

    seed = 42
    rng_type = "cuda"
    width = 832
    height = 480
    frames = 33
    fps = 16

    steps = 8
    high_noise_steps = 4
    cfg_scale = 3.5
    method = "euler"
    scheduler = "discrete"
}

fn main() {
    base_model = load_dit(model_path, family = "wan2", params_backend = "cpu")
    text = load_text_encoder(text_path, family = "wan2", params_backend = "cpu", t5_path = text_path)
    vae = load_vae(vae_path, family = "wan2", params_backend = "cpu")

    lora_0 = load_lora(lora_0_path)
    model = apply_lora(base_model, lora_0)
    base = tensor::zeros(latent_shape(vae, width = width, height = height, frames = frames))
    high_unpatched = load_dit(high_model_path, family = "wan2", params_backend = "cpu")
    lora_1 = load_lora(lora_1_path)
    high_base = apply_lora(high_unpatched, lora_1)

    positive = encode_prompt(text, prompt, width = width, height = height)
    negative = encode_prompt(text, negative_prompt, width = width, height = height)
    pos = predictor(model, positive)
    neg = predictor(model, negative)
    guided = cfg(pos, neg, scale = cfg_scale)
    high_pos = predictor(high_base, positive)
    high_neg = predictor(high_base, negative)
    high_guided = cfg(high_pos, high_neg, scale = cfg_scale)
    sigmas = make_sigmas(guided, latent = base, steps = steps, scheduler = scheduler, flow_shift = 3.0)
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    split = math::min(high_noise_steps, tensor::numel(sigmas) - 1)
    handoff = sample(start, sigmas[:split + 1], predict = high_guided, method = method, rng = rng)
    latent = sample(handoff, sigmas[split:], predict = guided, method = method, rng = rng)
    output_frames = vae_decode(vae, dit_to_vae_latents(vae, latent))
    video::save(output_path, {frames = output_frames, fps_num = fps, fps_den = 1}, audio = {})
    return {video = {frames = output_frames, fps_num = fps, fps_den = 1}, latent = latent, audio = {}}
}

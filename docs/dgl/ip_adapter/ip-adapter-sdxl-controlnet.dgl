# version: 0.0.0
# docs/models/ip_adapter.md — Combining with Control Net

var {
    weights = "../models/checkpoints/sdxl.safetensors"
    vision_encoder_path = "../models/clip_vision/clip_vision_h.safetensors"
    ip_adapter_path = "../models/ipadapter/ip-adapter_sdxl_vit-h.safetensors"
    control_path = "../models/controlnet/OpenPoseXL2.safetensors"

    input_path = "../inputs/character.png"
    control_image_path = "../inputs/pose.png"
    output_path = "output.png"

    prompt = "a character, side view"
    negative_prompt = ""
    zero_negative = true

    seed = 42
    width = 1024
    height = 1024

    steps = 25
    cfg_scale = 6.0
    method = "euler"
    scheduler = "discrete"
}

fn fit_canvas(input, width, height, mode) {
    shape = tensor::shape(input)
    crop_width = math::min(shape[1], math::floor(shape[2] * width / height))
    crop_height = math::min(shape[2], math::floor(shape[1] * height / width))
    start = [math::floor((shape[1] - crop_width) / 2), math::floor((shape[2] - crop_height) / 2)]
    cropped = tensor::crop(input, axes = [1, 2], start = start, size = [crop_width, crop_height])
    return tensor::interpolate(cropped, size = [width, height], axes = [1, 2], mode = mode)
}

fn sdxl_zero_text(cond) {
    zeroed = zero_out(cond, fields = ["crossattn"])
    pooled_zeros = tensor::zeros_like(cond.vector[:1280])
    adm = tensor::replace_slice(cond.vector, pooled_zeros, axis = 0, start = 0)
    return {crossattn = zeroed.crossattn, vector = adm}
}

fn main() {
    unet = load_unet(weights)
    text = load_text_encoder(weights)
    vae = load_vae(weights, conv_scale = 0.03125)
    vision = load_vision_encoder(vision_encoder_path)
    adapter = ip_adapter::load(ip_adapter_path, family = "sdxl")
    embedding = encode_vision(vision, image::load(input_path), pooled = true)
    positive_image = ip_adapter::project(adapter, embedding)
    negative_image = ip_adapter::project(adapter, tensor::zeros_like(embedding))
    positive = ip_adapter::apply(encode_prompt(text, prompt, width = width, height = height), adapter, positive_image, strength = 0.9)
    negative_text = encode_prompt(text, negative_prompt, width = width, height = height)
    negative_condition = if zero_negative {
        sdxl_zero_text(negative_text)
    } else {
        {crossattn = negative_text.crossattn, vector = negative_text.vector}
    }
    negative = ip_adapter::apply(negative_condition, adapter, negative_image, strength = 0.9)
    control = controlnet::load(control_path, family = "sdxl")
    hint = fit_canvas(image::load(control_image_path), width, height, mode = "nearest")
    controlled_positive = controlnet::apply(positive, control, hint, strength = 0.8)
    controlled_negative = controlnet::apply(negative, control, hint, strength = 0.8)
    pos = predictor(unet, controlled_positive, prediction = "eps")
    neg = predictor(unet, controlled_negative, prediction = "eps")
    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    guided = cfg(pos, neg, scale = cfg_scale)
    sigmas = make_sigmas(guided, latent = base, scheduler = scheduler, steps = steps)
    rng = make_rng("cuda", seed = seed)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = guided, method = method, rng = rng)
    image = vae_decode(vae, unet_to_vae_latents(vae, latent), tiling = tiling())
    image::save(output_path, image)
    return { image = image, latent = latent, image_tokens = positive_image }
}

# version: 0.0.0
# docs/models/animatediff.md — img2video

var {
    weights = "../models/checkpoints/realisticVisionV60B1.safetensors"

    output_path = "init.png"

    prompt = "a lovely cat"
    negative_prompt = ""

    seed = 42
    width = 512
    height = 512

    steps = 20
    cfg_scale = 7.0
    method = "euler_a"
    scheduler = "discrete"
}

fn main() {
    text = load_text_encoder(weights)
    vae = load_vae(weights)
    unet = load_unet(weights)
    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    rng = make_rng("cuda", seed = seed)
    pos = encode_prompt(text, prompt)
    neg = encode_prompt(text, negative_prompt)
    positive_predictor = predictor(unet, pos, prediction = "eps")
    negative_predictor = predictor(unet, neg, prediction = "eps")
    guided = cfg(positive_predictor, negative_predictor, scale = cfg_scale)
    sigmas = make_sigmas(guided, latent = base, scheduler = scheduler, steps = steps)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = guided, method = method, rng = rng)
    image = vae_decode(vae, unet_to_vae_latents(vae, latent))
    image::save(output_path, image)
    return { image = image, latent = latent, positive = pos, sigmas = sigmas }
}

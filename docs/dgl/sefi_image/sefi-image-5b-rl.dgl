# version: 0.0.0

var {
    dit_path = "SeFi-Image-5B-RL.safetensors"
    encoder_path = "Qwen3-VL-4B-Instruct.gguf"
    vae_path = "flux2_ae.safetensors"

    output_path = "sefi.png"

    prompt = "A small house in a forest clearing, warm afternoon light"
    negative_prompt = ""

    seed = 42
    width = 1024
    height = 1024

    cfg_scale = 4
}

fn main() {
    dit = load_dit(dit_path)
    text = load_text_encoder(encoder_path, family = "sefi_image")
    vae = load_vae(vae_path, family = "sefi_image")
    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    schedule = sefi::make_sigmas(steps = 20)
    rng = make_rng("cuda", seed = seed)
    pos = predictor(dit, encode_prompt(text, prompt))
    neg = predictor(dit, encode_prompt(text, negative_prompt))
    guided = cfg(pos, neg, scale = cfg_scale)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = schedule.sigmas[0])
    latent = sefi::sample(start, schedule.sigmas, predict = guided, semantic_sigmas = schedule.semantic_sigmas, finish = true, rng = rng)
    texture = latent[:, :, 16:144]
    image = vae_decode(vae, dit_to_vae_latents(vae, texture))
    image::save(output_path, image)
    return { image = image, latent = latent }
}

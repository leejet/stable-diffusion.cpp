# version: 0.0.0
# docs/models/sefi_image.md — 1B / 2B base

var {
    model_path = "../models/diffusion_models/sefi_1b_base.safetensors"
    text_path = "../models/text_encoders/qwen3_vl_2b.safetensors"
    vae_path = "../models/vae/flux2_ae.safetensors"

    output_path = "out.png"

    prompt = "a photograph of an orange tabby cat sitting on a couch"
    negative_prompt = ""

    seed = 42
    rng_type = "cuda"
    width = 1024
    height = 1024

    steps = 50
    cfg_scale = 4.0
    method = "euler"
}

fn main() {
    model = load_dit(model_path, family = "sefi_image", params_backend = "cpu")
    text = load_text_encoder(text_path, family = "sefi_image", params_backend = "cpu")
    vae = load_vae(vae_path, family = "sefi_image", params_backend = "cpu")

    base = tensor::zeros(latent_shape(vae, width = width, height = height))

    positive = encode_prompt(text, prompt, width = width, height = height)
    negative = encode_prompt(text, negative_prompt, width = width, height = height)
    pos = predictor(model, positive)
    neg = predictor(model, negative)
    guided = cfg(pos, neg, scale = cfg_scale)
    dual_schedule = sefi::make_sigmas(steps = steps)
    sigmas = dual_schedule.sigmas
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sefi::sample(start, sigmas, predict = guided, semantic_sigmas = dual_schedule.semantic_sigmas, method = method, rng = rng)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent[:, :, 16:144]))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

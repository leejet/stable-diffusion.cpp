# version: 0.0.0
# CLI/context: --max-vram 8
# docs/models/sefi_image.md — 5B (needs streaming on 12 GiB VRAM)

var {
    model_path = "../models/diffusion_models/sefi_5b_turbo.safetensors"
    text_path = "../models/text_encoders/qwen3_vl_4b.safetensors"
    vae_path = "../models/vae/flux2_ae.safetensors"

    output_path = "out.png"

    prompt = "a photograph of an orange tabby cat sitting on a couch"

    seed = 42
    rng_type = "cuda"
    width = 1024
    height = 1024

    steps = 4
    method = "euler"
}

fn main() {
    model = load_dit(model_path, family = "sefi_image", params_backend = "cpu")
    text = load_text_encoder(text_path, family = "sefi_image", params_backend = "cpu")
    vae = load_vae(vae_path, family = "sefi_image", params_backend = "cpu")

    base = tensor::zeros(latent_shape(vae, width = width, height = height))

    condition = encode_prompt(text, prompt, width = width, height = height)
    predict = predictor(model, condition)
    dual_schedule = sefi::make_sigmas(steps = steps)
    sigmas = dual_schedule.sigmas
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(predict, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sefi::sample(start, sigmas, predict = predict, semantic_sigmas = dual_schedule.semantic_sigmas, method = method, rng = rng)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent[:, :, 16:144]))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

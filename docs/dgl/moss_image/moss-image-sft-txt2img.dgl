# version: 0.0.0
# docs/models/moss_image.md — MOSS-Image SFT

var {
    model_path = "../models/diffusion_models/moss_image_sft_int8_convrot_attn.safetensors"
    text_path = "../models/text_encoders/Qwen3.5-9B-Q4_K_M.gguf"
    tokenizer_path = "../models/tokenizers/tokenizer_qwen3.5.json"
    vae_path = "../models/vae/flux2_ae.safetensors"

    output_path = "output.png"

    prompt = "a lovely cat holding a sign says 'moss-image.cpp'"
    negative_prompt = ""

    seed = 42
    rng_type = "cuda"
    width = 1024
    height = 1024

    steps = 20
    cfg_scale = 3.0
    method = "euler"
    scheduler = "discrete"
}

fn main() {
    model = load_dit(model_path, family = "moss_image", params_backend = "cpu")
    text = load_text_encoder(text_path, family = "moss_image", params_backend = "cpu", tokenizer = tokenizer_path)
    vae = load_vae(vae_path, family = "moss_image", params_backend = "cpu")

    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    positive = encode_prompt(text, prompt, width = width, height = height)
    negative = encode_prompt(text, negative_prompt, width = width, height = height)
    pos = predictor(model, positive)
    neg = predictor(model, negative, skip_layers = [22])
    guided = cfg(pos, neg, scale = cfg_scale)
    sigmas = make_sigmas(guided, latent = base, steps = steps, scheduler = scheduler)
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = guided, method = method, rng = rng)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

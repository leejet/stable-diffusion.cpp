# version: 0.0.0
# docs/models/esrgan.md — CLI

var {
    model_path = "../models/checkpoints/v1-5-pruned-emaonly.safetensors"
    upscaler_path = "../models/upscale_models/RealESRGAN_x4plus_anime_6B.pth"

    output_path = "output.png"

    prompt = "a lovely cat"
    negative_prompt = ""

    seed = 42
    rng_type = "cuda"
    width = 512
    height = 512

    steps = 20
    cfg_scale = 7.0
    method = "euler_a"
    scheduler = "discrete"
}

fn main() {
    model = load_unet(model_path, family = "sd1")
    text = load_text_encoder(model_path, family = "sd1")
    vae = load_vae(model_path, family = "sd1")

    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    positive = encode_prompt(text, prompt, width = width, height = height)
    negative = encode_prompt(text, negative_prompt, width = width, height = height)
    pos = predictor(model, positive)
    neg = predictor(model, negative)
    guided = cfg(pos, neg, scale = cfg_scale)
    sigmas = make_sigmas(guided, latent = base, steps = steps, scheduler = scheduler)
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = guided, method = method, rng = rng)
    image = vae_decode(vae, unet_to_vae_latents(vae, latent))
    upscaler = load_upscaler(upscaler_path)
    enlarged = upscale(upscaler, image)
    image::save(output_path, enlarged)
    return {image = enlarged, latent = latent}
}

# version: 0.0.0
# docs/models/hidream_o1_image.md — HiDream-O1-Image-Dev

var {
    model_path = "../models/checkpoints/hidream_o1_image_dev_bf16.safetensors"

    output_path = "output.png"

    prompt = "a lovely cat holding a sign says 'hidream o1 cpp'"

    seed = 42
    rng_type = "cuda"
    width = 1024
    height = 1024

    steps = 28
    method = "lcm"
    scheduler = "lcm"
    noise_scale = 8.0
    extra_sample_args = "noise_scale_start=7.5,noise_scale_end=7.5,noise_clip_std=2.5"
}

fn main() {
    model = load_dit(model_path, family = "hidream_o1")
    text = load_text_encoder(model_path, family = "hidream_o1")
    vae = load_vae(model_path, family = "hidream_o1")

    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    condition = encode_prompt(text, prompt, width = width, height = height)
    predict = predictor(model, condition)
    sigmas = make_sigmas(predict, latent = base, steps = steps, scheduler = scheduler)
    rng = make_rng(rng_type, seed = seed)
    noise = tensor::affine(tensor::randn_like(base, rng = rng), scale = noise_scale)
    start = add_noise(predict, base, noise, sigma = sigmas[0])
    latent = sample(start, sigmas, predict = predict, method = method, rng = rng, extra_args = extra_sample_args)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

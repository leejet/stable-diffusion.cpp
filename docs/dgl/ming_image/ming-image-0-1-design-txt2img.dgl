# version: 0.0.0
# docs/models/ming_image.md — Text-to-image

var {
    model_path = "../models/diffusion_models/ming_image_0.1_design_bf16.safetensors"
    text_path = "../models/text_encoders/ming_image_0.1_ling_mini_2.0_bf16.safetensors"
    tokenizer_path = "../models/tokenizers/tokenizer.json"
    vae_path = "../models/vae/ming_image_vae_bf16.safetensors"

    output_path = "ming_image.png"

    prompt = "A cheerful orange cat sticker, transparent background"

    seed = 42
    rng_type = "cuda"
    width = 1024
    height = 1024

    steps = 12
    method = "euler"
    scheduler = "discrete"
}

fn main() {
    model = load_dit(model_path, family = "ming_image", params_backend = "cpu")
    text = load_text_encoder(text_path, family = "ming_image", params_backend = "cpu", tokenizer = tokenizer_path)
    vae = load_vae(vae_path, family = "ming_image", params_backend = "cpu")

    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    condition = encode_prompt(text, prompt, width = width, height = height)
    predict = predictor(model, condition)
    sigmas = make_sigmas(predict, latent = base, steps = steps, scheduler = scheduler)
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(predict, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = predict, method = method, rng = rng)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

# version: 0.0.0
# docs/models/kandinsky_imagesr.md — standalone image upscaling

var {
    upscaler_path = "../models/Kandinsky-ImageSR-2.0"

    input_path = "input.png"
    output_path = "upscaled.png"
}

fn main() {
    upscaler = load_upscaler(upscaler_path)
    image = image::load(input_path)
    output = upscale(upscaler, image, factor = 2)
    image::save(output_path, output)
    return output
}

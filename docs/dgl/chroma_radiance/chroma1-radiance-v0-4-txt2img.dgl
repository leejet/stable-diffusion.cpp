# version: 0.0.0
# docs/models/chroma_radiance.md — CLI

var {
    model_path = "../models/diffusion_models/Chroma1-Radiance-v0.4-Q8_0.gguf"
    text_path = "../models/text_encoders/clip/t5xxl_fp16.safetensors"

    output_path = "output.png"

    prompt = "a lovely cat holding a sign says 'chroma  radiance cpp'"
    negative_prompt = ""

    seed = 42
    rng_type = "cuda"
    width = 512
    height = 512

    steps = 20
    cfg_scale = 4.0
    method = "euler"
    scheduler = "flux"
}

fn main() {
    model = load_dit(model_path, family = "chroma_radiance")
    text = load_text_encoder(text_path, family = "chroma_radiance", t5_path = text_path)
    vae = load_vae(model_path, family = "chroma_radiance")

    base = tensor::zeros(latent_shape(vae, width = width, height = height))
    positive = encode_prompt(text, prompt, width = width, height = height)
    negative = encode_prompt(text, negative_prompt, width = width, height = height)
    pos = predictor(model, positive)
    neg = predictor(model, negative)
    guided = cfg(pos, neg, scale = cfg_scale)
    sigmas = make_sigmas(guided, latent = base, steps = steps, scheduler = scheduler)
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(guided, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = guided, method = method, rng = rng)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

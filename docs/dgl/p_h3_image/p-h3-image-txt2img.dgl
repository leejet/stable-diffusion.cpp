# version: 0.0.0
# docs/models/p_h3_image.md — Text-to-image

var {
    model_path = "../models/diffusion_models/p-h3-image_int8_convrot.safetensors"
    text_path = "../models/text_encoders/qwen3vl_4b_bf16.safetensors"
    connectors_path = "../models/text_encoders/p-h3-image_text_connector.safetensors"
    vae_path = "../models/vae/p-h3-image_vae_bf16.safetensors"

    output_path = "output.png"

    prompt = "a lovely cat holding a sign says 'p-h3-image.cpp'"

    seed = 42
    rng_type = "cpu"
    width = 2912
    height = 2912

    method = "euler"
    custom_sigmas = [1.0, 0.9847530126571655, 0.9679049849510193, 0.9516879916191101, 0.9253720045089722, 0.8819230198860168, 0.8100829720497131, 0.5287179946899414, 0.0]
}

fn main() {
    model = load_dit(model_path, family = "p_h3_image", params_backend = "cpu")
    text = load_text_encoder(text_path, connectors_path = connectors_path, family = "p_h3_image", params_backend = "cpu", projection_path = model_path)
    vae = load_vae(vae_path, family = "p_h3_image", params_backend = "cpu")

    image_base = tensor::zeros(latent_shape(vae, width = width, height = height))
    image_shape = tensor::shape(image_base)
    image_video = tensor::unsqueeze(image_base, axis = 2)
    audio_channels = math::ceil_div(128, image_shape[0] * image_shape[1])
    base = tensor::concat([image_video, tensor::zeros([image_shape[0], image_shape[1], 1, audio_channels, 1])], axis = 3)

    condition = encode_prompt(text, prompt, width = width, height = height)
    predict = predictor(model, condition, video_sigma_shift = 1, audio_length = 2, audio_sigma_shift = 1)
    sigmas = tensor::vector(custom_sigmas, dtype = "f32")
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(predict, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = predict, method = method, rng = rng)
    image = vae_decode(vae, dit_to_vae_latents(vae, latent[:, :, :, :24]))
    image::save(output_path, image)
    return {image = image, latent = latent}
}

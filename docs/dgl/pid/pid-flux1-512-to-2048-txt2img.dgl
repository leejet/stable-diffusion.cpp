# version: 0.0.0
# docs/models/pid.md — CLI

var {
    model_path = "../models/diffusion_models/pid_flux1_512_to_2048_4step_bf16.safetensors"
    text_path = "../models/text_encoders/gemma_2_2b_it_elm_bf16.safetensors"
    tokenizer_path = "../models/tokenizers/tokenizer_gemma2.json"
    vae_path = "../models/vae/ae.sft"

    reference_0_path = "../inputs/ernie_image/turbo_example.png"
    output_path = "output.png"

    prompt = "a lovely cat"

    seed = 42
    rng_type = "cpu"
    width = 2048
    height = 2048

    steps = 4
    method = "lcm"
    scheduler = "lcm"
}

fn main() {
    reference_0 = image::load(reference_0_path)

    model = load_dit(model_path, family = "pid")
    text = load_text_encoder(text_path, family = "pid", tokenizer = tokenizer_path)
    vae = load_vae(vae_path, family = "pid", vae_format = "flux")

    encode_rng = make_rng(rng_type, seed = seed)
    base = tensor::zeros([width, height, 3, 1])
    reference_0_pixels = image::to_f32(reference_0, channels = 3)
    reference_latent_0 = vae_to_dit_latents(vae, vae_encode(vae, reference_0_pixels, rng = encode_rng))

    condition = encode_prompt(text, prompt, width = width, height = height)
    predict = predictor(model, condition, ref_latents = [reference_latent_0])
    sigmas = make_sigmas(predict, latent = base, steps = steps, scheduler = scheduler)
    rng = make_rng(rng_type, seed = seed)
    start = add_noise(predict, base, tensor::randn_like(base, rng = rng), sigma = sigmas[0])
    latent = sample(start, sigmas, predict = predict, method = method, rng = rng)
    pixels = tensor::clamp(tensor::affine(latent, scale = 0.5, offset = 0.5), 0, 1)
    image = image::to_u8(pixels)
    image::save(output_path, image)
    return {image = image, latent = latent}
}
